# PeopleSoft HCM → Veza OAA Integration — Environment Template
# Copy this file to .env, fill in real values, and set permissions:
#   cp .env.example .env && chmod 600 .env
#
# DO NOT commit .env to version control — it contains credentials.

# ── Oracle JDBC Configuration ─────────────────────────────────────────────
# PeopleSoft HCM Oracle database host
PS_DB_HOST=your-oracle-host.example.com

# Oracle listener port (PeopleSoft HCM commonly uses 1521 or 1526)
PS_DB_PORT=1521

# Oracle service name (found in tnsnames.ora or from your DBA)
PS_DB_SERVICE=your_oracle_service_name

# Read-only database account for Veza integration
PS_DB_USER=mimreader

# Database password (will be masked in logs)
PS_DB_PASSWORD=your_db_password_here

# Full path to Oracle JDBC driver JAR installed by install_peoplesoft_hcm.sh
JDBC_DRIVER_PATH=/opt/VEZA/peoplesoft-hcm-veza/jdbc/ojdbc11.jar

# ── Veza Configuration ────────────────────────────────────────────────────
# Your Veza tenant URL (include https://)
VEZA_URL=https://your-tenant.veza.com

# Veza API key (generate in Veza UI: Admin → API Keys)
VEZA_API_KEY=your_veza_api_key_here

# ── OAA Provider Settings ─────────────────────────────────────────────────
# Provider name as it will appear in Veza's Access Graph
# PROVIDER_NAME=PeopleSoft HCM

# Datasource name (use an instance-specific identifier if running multiple environments)
# DATASOURCE_NAME=PeopleSoft HCM Production
